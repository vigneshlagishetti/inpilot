# ==============================================================================
# Inpilot Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Clerk Authentication
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ------------------------------------------------------------------------------
# Supabase
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://...supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ------------------------------------------------------------------------------
# AI Configuration (Groq / OpenAI)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=gsk_...
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# Email Configuration
# ------------------------------------------------------------------------------
# SendGrid (Preferred)
SENDGRID_API_KEY=SG....

# SMTP / Gmail (Alternative for Contact Form)
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password-here
# EMAIL_FROM=your-email@gmail.com
# EMAIL_TO=admin-email@gmail.com

# ------------------------------------------------------------------------------
# Application State
# ------------------------------------------------------------------------------
# Set to 'true' to enable maintenance mode globally (checked by middleware)
NEXT_PUBLIC_MAINTENANCE_MODE=false